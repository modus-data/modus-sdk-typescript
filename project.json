{
  "name": "modus-sdk-typescript",
  "sourceRoot": "distribution/clients/typescript/modus-sdk/src",
  "projectType": "library",
  "tags": ["scope:sdk", "type:lib", "lang:typescript"],
  "implicitDependencies": ["modus-api", "agent-service", "openapi-portal"],
  "targets": {
    "typecheck": {},
    "generate-spec": {
      "executor": "nx:run-commands",
      "dependsOn": [
        { "projects": ["modus-api", "agent-service"], "target": "openapi:generate" },
        { "projects": ["openapi-portal"], "target": "build" }
      ],
      "options": {
        "command": "node distribution/clients/typescript/scripts/generate-sdk-from-openapi.mjs --spec-only",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "{workspaceRoot}/distribution/clients/sdk-surface.json"],
      "outputs": ["{projectRoot}/src/_generated/public-openapi.json"],
      "cache": false
    },
    "generate": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-spec"],
      "options": {
        "command": "node distribution/clients/typescript/scripts/generate-sdk-from-openapi.mjs --from-spec",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["default", "{workspaceRoot}/distribution/clients/sdk-surface.json"],
      "outputs": ["{projectRoot}/src/_generated/**"],
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "pnpm --filter @getmodus/sdk run build",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "dependsOn": ["build"],
      "options": {
        "command": "vitest run --root distribution/clients/typescript/modus-sdk",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/apps/services/*/openapi/v1.json",
        "{workspaceRoot}/packages/openapi-portal/src/**/*.ts",
        "{workspaceRoot}/distribution/clients/typescript/scripts/**",
        "{workspaceRoot}/distribution/clients/sdk-surface.json",
        "{workspaceRoot}/distribution/clients/sdk-surface.schema.json"
      ]
    },
    "test-staging-smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm --filter @getmodus/sdk run test:staging-smoke",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "lint": {
      "dependsOn": ["typecheck"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @getmodus/sdk run clean",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "check-docstrings": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash -c 'bash ../scripts/check-sdk-public-docstrings.sh && node ../scripts/check-generated-names.mjs && node ../scripts/check-sdk-docs-coverage.mjs'",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/src/_generated/v1.ts",
        "{workspaceRoot}/distribution/clients/typescript/scripts/check-sdk-public-docstrings.sh",
        "{workspaceRoot}/distribution/clients/typescript/scripts/check-generated-names.mjs",
        "{workspaceRoot}/distribution/clients/typescript/scripts/check-sdk-docs-coverage.mjs"
      ]
    },
    "coverage-gaps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../scripts/coverage-gaps.mjs --fail-on-gaps",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/apps/services/*/openapi/v1.json",
        "{workspaceRoot}/packages/openapi-portal/src/**/*.ts",
        "{workspaceRoot}/distribution/clients/sdk-surface.json",
        "{workspaceRoot}/distribution/clients/typescript/scripts/coverage-gaps.mjs"
      ]
    },
    "contract-check": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["openapi-portal"], "target": "build" }],
      "options": {
        "command": "bash distribution/clients/typescript/scripts/check-contract.sh",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/services/*/openapi/v1.json",
        { "dependentTasksOutputFiles": "**/*.js" },
        "{workspaceRoot}/distribution/clients/typescript/scripts/**",
        "{workspaceRoot}/distribution/clients/sdk-surface.json"
      ]
    },
    "sdk:check": {
      "executor": "nx:noop",
      "dependsOn": ["check-docstrings", "coverage-gaps", "contract-check"]
    },
    "public-surface": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node distribution/clients/typescript/scripts/emit-public-surface.mjs --write",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{projectRoot}/tests/snapshots/public-surface.json"],
      "cache": false
    },
    "public-surface-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node distribution/clients/typescript/scripts/emit-public-surface.mjs --check",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "openapi-impact": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "command": "bash ../scripts/ci-openapi-sdk-impact-ts.sh",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
