{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@getmodus/sdk",
  "entryPoints": [
    "docs/typedoc/Modus.ts",
    "docs/typedoc/Modus.scopes.ts",
    "docs/typedoc/Modus.scopes.conversations.ts",
    "docs/typedoc/Modus.context.ts",
    "docs/typedoc/Modus.workflows.ts",
    "docs/typedoc/Modus.connections.ts",
    "docs/typedoc/Modus.chat.ts",
    "docs/typedoc/Modus.suggestions.ts",
    "docs/typedoc/Modus.ingestedData.ts",
    "docs/typedoc/Modus.errors.ts",
    "docs/typedoc/Management.ts",
    "docs/typedoc/Management.scopes.ts",
    "docs/typedoc/Management.context.ts",
    "docs/typedoc/Management.workflows.ts",
    "docs/typedoc/Management.tools.ts",
    "docs/typedoc/Management.usage.ts",
    "docs/typedoc/Management.users.ts",
    "docs/typedoc/types.ts"
  ],
  "entryPointStrategy": "resolve",
  "tsconfig": "docs/typedoc/tsconfig.json",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "exclude": [
    "**/_generated/**",
    "**/_http.ts",
    "**/_client-base.ts",
    "**/_auth.ts",
    "**/_retry.ts",
    "**/_request.ts",
    "**/_openapi-invoke.ts",
    "**/_query.ts",
    "**/_streaming.ts",
    "**/_validation.ts",
    "**/_agent_run_request.ts",
    "**/_content-merge.ts",
    "**/_deprecation.ts",
    "**/_version.ts",
    "**/*.spec.ts",
    "**/*.test.ts"
  ],
  "readme": "none",
  "skipErrorChecking": true,
  "sort": ["source-order"],
  "navigation": {
    "includeCategories": false,
    "includeGroups": false,
    "includeFolders": false,
    "compactFolders": true
  },
  "json": "../../../docs/sdk-artifacts/typedoc.json"
}
